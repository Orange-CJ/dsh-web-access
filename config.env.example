# 复制为 config.env 后按需改（config.env 不要提交）

# 长期偏好的浏览器：chrome / edge；留空则每次询问
WEB_ACCESS_BROWSER=chrome

# bridge 扩展通道（必需）
# 本仓 extension/ 被加载后 ID 恒为此值，由 manifest.json 里写死的 key 推出
WEB_ACCESS_EXTENSION_ID=iaappcdoajokfdnpghgkmngcboceoegd

# CDP 后备通道端口（装了扩展一般用不到，hex target id 才会走这里）
WEB_ACCESS_PORT=9229

# 控制面鉴权：1 = 除 /health 外全部要求 x-web-access-token
# 打开时 token 缺失，代理会拒绝启动（不静默降级）
WEB_ACCESS_TOKEN_ENFORCE=1
