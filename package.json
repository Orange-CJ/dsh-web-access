{
  "name": "dsh-web-access",
  "version": "1.1.0",
  "description": "DSH 浏览器插件：通过 bridge 扩展与 CDP 两通道操作你自己的浏览器，提供开页、读页、取内容、截图、标签与站点笔记工具。同时适配 web profile 与 DSH Desktop（Electron Node 模式）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "scripts/",
    "extension/",
    "references/",
    "config.env.example",
    "UPSTREAM-NOTICE.md",
    "README.md",
    "CREDITS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-access",
    "browser",
    "cdp",
    "chrome-extension"
  ],
  "scripts": {
    "test": "node scripts/test-agent-bridge.mjs"
  },
  "devDependencies": {
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  }
}
