{
  "manifest_version": 3,
  "name": "dsh-web-access bridge",
  "version": "0.2.0",
  "description": "让本地代理通过 chrome.debugger 驱动本浏览器，免开远程调试端口、免 --remote-allow-origins。默认只操作本桥创建的托管标签。",
  "key": "",
  "permissions": ["debugger", "tabs", "alarms", "storage"],
  "host_permissions": ["ws://127.0.0.1/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "sw.js" }
}
